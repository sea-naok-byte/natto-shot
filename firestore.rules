rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 合言葉+名前。最初の1回だけ作成でき、以後は書き換え不可(誤って上書きされないため)。
    // Cloud Functionsを使わないため、認証済み(匿名)のユーザーなら読めてしまう点に注意。
    // これは「URLと合言葉を知っている身近な二人だけで使う」前提の簡易的な保護です。
    match /meta/setup {
      allow read: if request.auth != null;
      allow create: if request.auth != null && !exists(/databases/$(database)/documents/meta/setup);
      allow update, delete: if false;
    }

    match /shifts/{doc} {
      allow read, write: if request.auth != null;
    }

    match /chat/{doc} {
      allow read, write: if request.auth != null;
    }

    match /diary/{doc} {
      allow read, write: if request.auth != null;
    }

    match /calls/{doc} {
      allow read, write: if request.auth != null;
    }

    match /fcmTokens/{doc} {
      allow read, write: if request.auth != null;
    }

    match /wants/{doc} {
      allow read, write: if request.auth != null;
    }
  }
}
